# =============================================================================
# docker/.env  —  Phase 4 Cluster Configuration
# MPJ-SPARK Multi-Driver Architecture
# University of Jaffna — EC6070 — 2022/E/033 & 2022/E/090
#
# All tuneable parameters for the Docker cluster are defined here.
# docker-compose.yml reads these via ${VAR} substitution.
#
# Edit this file to change cluster size, dataset sizes, or port mappings.
# Do NOT commit secrets here — this file is safe to commit (no credentials).
# =============================================================================

# ---------------------------------------------------------------------------
# Cluster Size
# NUM_WORKERS       : number of independent Spark driver workers (MPI ranks 1..N)
# NUM_WORKERS_PLUS_ONE : total MPI size (root + workers) — used for MPI_SIZE env
# ---------------------------------------------------------------------------
NUM_WORKERS=2
NUM_WORKERS_PLUS_ONE=3

# ---------------------------------------------------------------------------
# NFS Server
# NFS_SERVER_IP: IP of the host machine's Docker bridge gateway.
# Find with: docker network inspect mpj-spark-net --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# Default for Docker bridge is 172.20.0.1 (matches nfs-setup.sh subnet)
# ---------------------------------------------------------------------------
NFS_SERVER_IP=172.20.0.1

# ---------------------------------------------------------------------------
# Dataset Sizes (in MB)
# Increase for Phase 5 multi-node scale experiments.
# ---------------------------------------------------------------------------
KMEANS_DATASET_SIZE_MB=50
LOGREG_DATASET_SIZE_MB=50
LOGREG_NUM_FEATURES=10
KMEANS_NUM_FEATURES=10

# ---------------------------------------------------------------------------
# Spark Web UI Port Mapping
# Each container maps its internal port 4040 to a unique host port.
# Access UIs at: http://localhost:4040  (root)
#                http://localhost:4041  (worker-1)
#                http://localhost:4042  (worker-2)
# ---------------------------------------------------------------------------
SPARK_UI_PORT_BASE=4040
SPARK_UI_PORT_BASE_WORKER1=4041
SPARK_UI_PORT_BASE_WORKER2=4042
