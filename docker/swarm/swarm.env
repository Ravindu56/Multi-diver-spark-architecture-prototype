# P5-03 Swarm deployment tunables.
# `docker stack deploy` does NOT read .env files. scripts/bootstrap_stack.sh
# sources docker/.env (Phase-4 values) first, then this file, before
# rendering the stack.
#
# Topology modes:
#   MPI_SIZE=3  -> dedicated (default): 1 root + 2 workers, one per VM
#   MPI_SIZE=9  -> extended 8-worker: root exclusive on swarm-manager,
#                  workers 1-2 dedicated (swarm-worker1, swarm-worker2),
#                  workers 3-6 co-located on swarm-worker1 (4 ranks, 400m heap),
#                  workers 7-8 co-located on swarm-worker2 (2 ranks, 400m heap)
export MPI_SIZE="${MPI_SIZE:-3}"
export STACK_NAME="${STACK_NAME:-mpj}"
export MANAGER_IP="${MANAGER_IP:-192.168.122.224}"
