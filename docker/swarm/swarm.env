# P5-03 Swarm deployment tunables.
# `docker stack deploy` does NOT read .env files. scripts/bootstrap_stack.sh
# sources docker/.env (Phase-4 values) first, then this file, before
# rendering the stack.
#
# Topology selection is via bootstrap_stack.sh arguments (overlays hardcode
# the per-service MPI_SIZE, so no manual export is needed):
#   ./scripts/bootstrap_stack.sh      -> Cell A: dedicated 3-rank (1 rank/VM)
#   ./scripts/bootstrap_stack.sh 4w   -> Cell B: 5-rank (worker-1,3 on
#                                        swarm-worker1; worker-2,4 on swarm-worker2)
#   ./scripts/bootstrap_stack.sh 8w   -> Cell C: 9-rank (worker-1,3,4,5 on
#                                        swarm-worker1; worker-2,6,7,8 on
#                                        swarm-worker2 = 4 ranks per worker VM;
#                                        co-located ranks carry a 400m heap cap)
export MPI_SIZE="${MPI_SIZE:-3}"
export STACK_NAME="${STACK_NAME:-mpj}"
export MANAGER_IP="${MANAGER_IP:-192.168.122.224}"
